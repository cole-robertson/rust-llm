#!/usr/bin/env ruby
# Converts the upstream VCR cassettes the Rust replay tests use into JSON (keeps !binary bodies decoded).
require 'yaml'
require 'json'
src = File.expand_path('../upstream/spec/fixtures/vcr_cassettes', __dir__)
dst = File.expand_path('../crates/rust_llm/tests/cassettes', __dir__)
patterns = ARGV.empty? ? ['*'] : ARGV
count = 0
patterns.each do |pat|
  Dir.glob(File.join(src, "#{pat}.yml")).each do |file|
    # Providers RustLLM doesn't implement: their cassettes would never be replayed.
    next if File.basename(file).match?(/_(azure|bedrock|vertexai|cohere|elevenlabs|deepgram)_/)
    data = YAML.unsafe_load_file(file)
    interactions = data.fetch('http_interactions').map do |i|
      body = ->(b) { s = b['string'].to_s; s.force_encoding('UTF-8'); s.valid_encoding? ? s : s.scrub }
      raw = i['response']['body']['string'].to_s.dup.force_encoding('UTF-8')
      {
        'method' => i['request']['method'],
        'uri' => i['request']['uri'],
        'request_body' => body.(i['request']['body']),
        'status' => i['response']['status']['code'],
        'response_headers' => i['response']['headers'].transform_values { |v| Array(v).first },
        'response_body' => body.(i['response']['body'])
      }.tap do |h|
        # Binary downloads (an image a URL attachment fetches) keep their exact bytes.
        h['response_body_base64'] = [raw.b].pack('m0') unless raw.valid_encoding?
      end
    end
    File.write(File.join(dst, File.basename(file, '.yml') + '.json'), JSON.pretty_generate(interactions))
    count += 1
  end
end
puts "converted #{count}"
