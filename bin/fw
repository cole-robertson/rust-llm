#!/usr/bin/env bash
# Sync this repo to the build box and run a command there (builds stay off Archie).
# Usage: bin/fw cargo test -p rust_llm   (BUILD_HOST=framework bin/fw ... to use another box)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
HOST="${BUILD_HOST:-rebulk}"
REMOTE_DIR="src/tries/rust-llm"
case "$REMOTE_DIR" in */rust-llm) ;; *) echo "refusing: unexpected remote dir" >&2; exit 1;; esac
ssh "$HOST" "mkdir -p ~/$REMOTE_DIR"
rsync -a --delete --exclude target --exclude upstream --exclude .git "$ROOT/" "$HOST:$REMOTE_DIR/"
ssh "$HOST" "cd ~/$REMOTE_DIR && $(printf '%q ' "$@")"
