#!/usr/bin/env ruby
# Builds docs/PARITY.md: every `it` example in upstream/spec/ruby_llm/**/*_spec.rb with its status
# in the Rust port. Evidence, strongest first:
#   PORTED    a Rust test cites it with `// spec: <file>:<line>` (the line of the `it`)
#   REPLAYED  a Rust test replayed its recorded cassette (from a cassette log, see below)
#   rules     docs/parity-rules.txt: N/A (with the reason), OWNED (another in-flight lane),
#             PORTED (covered by a named test that does not cite the line), or MISSING
#   MISSING   everything else
# The cassette log comes from a full test run:
#   bin/fw bash -c 'RUST_LLM_CASSETTE_LOG=/tmp/cassettes.log cargo test --workspace --tests'
#   scp framework:/tmp/cassettes.log docs/parity-cassettes.log   (then sort -u it)
# Usage: bin/parity [cassette-log]   (default docs/parity-cassettes.log)
require 'json'

root = File.expand_path('..', __dir__)
examples = `#{root}/bin/spec-examples`.lines.map { JSON.parse(_1) }
abort 'bin/spec-examples produced nothing' if examples.empty?

def parameterize(s)
  s.unicode_normalize(:nfkd).encode('ASCII', invalid: :replace, undef: :replace, replace: '').downcase
   .gsub(/[^a-z0-9\-_]+/, '_').gsub(/_{2,}/, '_').gsub(/\A_|_\z/, '')
end

# Cassettes: RSpec names them after `example.full_description.parameterize`; interpolated
# descriptions (`#{provider}/#{model} ...`) match any expansion.
cassettes = Dir.children(File.join(root, 'upstream/spec/fixtures/vcr_cassettes')).map { _1.delete_suffix('.yml') }
log = ARGV[0] || File.join(root, 'docs/parity-cassettes.log')
replayed = {}
File.readlines(log, chomp: true).each do |line|
  name, bin = line.split("\t")
  (replayed[name] ||= []) << bin if name && !name.empty?
end if File.exist?(log)

# `// spec: chat_loop_spec.rb:48 ...` citations, keyed by "path/relative/to/spec/ruby_llm:line".
citations = Hash.new { |h, k| h[k] = [] }
Dir.glob(File.join(root, 'crates/**/*.rs')).each do |rs|
  File.foreach(rs) do |l|
    l.scan(%r{spec:\s*([a-z0-9_/]+_spec\.rb):(\d+)}) { |f, n| citations["#{f}:#{n}"] << rs.delete_prefix("#{root}/") }
  end
end

# Rules: `<pattern>\t<STATUS>\t<note>`; pattern is a spec path (relative to spec/ruby_llm/, globs
# allowed) optionally with `:line`. A `:line` rule beats a file rule, which beats a glob; among
# equals the later line wins.
rules = File.readlines(File.join(root, 'docs/parity-rules.txt'), chomp: true)
             .reject { _1.strip.empty? || _1.start_with?('#') }
             .map.with_index do |l, i|
  pattern, status, note = l.split("\t", 3)
  abort "bad rule: #{l}" unless %w[N/A OWNED PORTED MISSING].include?(status)
  file, line = pattern.split(':')
  rank = line ? 2 : (file.match?(/[*?\[{]/) ? 0 : 1)
  { file:, line: line&.to_i, status:, note: note.to_s, rank:, order: i }
end

rows = examples.map do |e|
  rel = e['file'].delete_prefix('spec/ruby_llm/')
  full = (e['path'] + [e['it']]).join(' ')
  rx = full.split(/(#\{[^}]*\})/).map { |p| p.start_with?('#{') ? '.*' : Regexp.escape(parameterize(p)).gsub('_', '_?') }.join('_?')
  re = /\A(rubyllm_)?#{rx.sub(/\A(_\?)+/, '').sub(/\Arubyllm_\?/, '')}\z/
  mine = cassettes.grep(re)
  hits = mine.select { replayed[_1] }
  cited = citations["#{rel}:#{e['line']}"]
  rule = rules.select { |r| (r[:line].nil? || r[:line] == e['line']) && File.fnmatch?(r[:file], rel, File::FNM_PATHNAME | File::FNM_EXTGLOB) }
              .max_by { |r| [r[:rank], r[:order]] }
  status, note =
    if cited.any? then ['PORTED', cited.uniq.map { "`#{_1}`" }.join(', ')]
    elsif hits.any? then ['REPLAYED', "#{hits.size}/#{mine.size} cassettes, `#{hits.flat_map { replayed[_1] }.uniq.join('`, `')}`"]
    elsif rule then [rule[:status], rule[:note]]
    else ['MISSING', mine.any? ? "#{mine.size} cassette(s) recorded, none replayed" : '']
    end
  { rel:, line: e['line'], context: e['path'][1..].to_a.join(' > '), it: e['it'], status:, note: }
end

totals = rows.group_by { _1[:status] }.transform_values(&:size)
order = %w[PORTED REPLAYED OWNED N/A MISSING]
per_file = rows.group_by { _1[:rel] }

esc = ->(s) { s.to_s.gsub('|', '\|').gsub("\n", ' ') }
out = +"# Parity with RubyLLM 2.0, spec by spec\n\n"
out << "Generated by `bin/parity` from every `it` in `upstream/spec/ruby_llm/**/*_spec.rb` " \
       "(#{per_file.size} files, #{rows.size} examples, parsed with Prism by `bin/spec-examples`). " \
       "Do not edit by hand: change `docs/parity-rules.txt` or cite the example from a test " \
       "(`// spec: <file>:<line> <description>`), then rerun `bin/parity`.\n\n"
out << "| Status | Examples | Meaning |\n|---|---:|---|\n"
{
  'PORTED' => 'a Rust test ports the example and cites it by file and line (or a rule names the test)',
  'REPLAYED' => "a Rust test replays the example's own recorded cassette and asserts its request bodies",
  'OWNED' => 'not ported yet, and inside another in-flight agent lane (named)',
  'N/A' => 'no Rust counterpart, with the reason (Ruby-only mechanism, or a provider this port leaves out)',
  'MISSING' => 'in scope for the port and not covered'
}.each { |s, m| out << "| #{s} | #{totals.fetch(s, 0)} | #{m} |\n" }
out << "| **Total** | **#{rows.size}** | |\n\n"
na = rows.select { _1[:status] == 'N/A' }
scope = na.count { _1[:note].start_with?('provider not ported') }
out << "N/A splits into #{scope} examples for providers this port leaves out (Azure, Bedrock, Vertex AI, " \
       "Cohere, ElevenLabs, Deepgram, per BRIEF.md) and #{na.size - scope} with no Rust counterpart.\n\n"

out << "## By file\n\n| Spec | Examples | #{order.join(' | ')} |\n|---|---:|#{'---:|' * order.size}\n"
per_file.sort.each do |file, rs|
  counts = rs.group_by { _1[:status] }.transform_values(&:size)
  out << "| [`#{file}`](#spec-#{file.tr('/._', '---')}) | #{rs.size} | #{order.map { counts[_1] || '' }.join(' | ')} |\n"
end

out << "\n## Every example\n"
per_file.sort.each do |file, rs|
  out << "\n### <a id=\"spec-#{file.tr('/._', '---')}\"></a>`#{file}`\n\n| Line | Example | Status | Evidence / reason |\n|---:|---|---|---|\n"
  rs.each do |r|
    label = [r[:context], r[:it]].reject(&:empty?).join(' > ')
    out << "| #{r[:line]} | #{esc.(label)} | #{r[:status]} | #{esc.(r[:note])} |\n"
  end
end

File.write(File.join(root, 'docs/PARITY.md'), out)
puts order.map { "#{_1} #{totals.fetch(_1, 0)}" }.join(', ') + " (#{rows.size} examples, #{per_file.size} files)"
